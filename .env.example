# Postgres and Redis are provided by docker-compose.dev.yml. These ports are
# fixed, so two projects from this template cannot run at once without editing
# this file and docker-compose.dev.yml together.
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/ai_ts_base?schema=public"
REDIS_URL="redis://localhost:16379"

# The API's port. The frontend must be told the same value via VITE_API_URL.
PORT="3000"
VITE_API_URL="http://localhost:3000"

# The one browser origin the API accepts. Must match the frontend's URL exactly
# (scheme, host, and port) — CORS rejects everything else. Vite falls back to
# another port when 5173 is taken, so update this if it does.
FRONTEND_ORIGIN="http://localhost:5173"

# Optional. Namespaces BullMQ jobs; change it only if you share one Redis with
# another project and want the queues kept apart.
# QUEUE_NAME="default"

# AI runtime (Anvia over OpenRouter). Leave the key unset to keep AI calls
# disabled: the enrich endpoint then returns the note to Draft instead of
# hanging, so the pipeline stays exercisable with no account.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_ENRICH_MODEL="openai/gpt-4o-mini"
