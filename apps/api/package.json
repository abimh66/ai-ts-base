{
  "name": "api",
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "worker": "pnpm with-env tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "with-env": "dotenv -e ../../.env --",
    "db": "pnpm with-env prisma",
    "db:generate": "pnpm with-env prisma generate",
    "db:push": "pnpm with-env prisma db push",
    "db:seed": "pnpm with-env prisma db seed",
    "db:studio": "pnpm with-env prisma studio"
  },
  "dependencies": {
    "@anvia/core": "^1.12.0",
    "@anvia/openai": "^1.3.0",
    "@hono/node-server": "^2.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.12",
    "hono": "^4.13.13",
    "ioredis": "^6.0.0",
    "prisma": "^7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
